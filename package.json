{
  "name": "dscentsation-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "node init && concurrently -k -n API,WEB -c blue,green \"pnpm --filter @dms/api dev\" \"pnpm --filter @dms/web dev\"",
    "lint": "eslint apps eslint.config.js",
    "format": "prettier --single-quote --trailing-comma all --print-width 100 --write \"apps/**/*.{ts,tsx,js,css,html,json}\" \"package.json\" \"tsconfig.base.json\" \"eslint.config.js\" \"docs/development/*.md\"",
    "format:check": "prettier --single-quote --trailing-comma all --print-width 100 --check \"apps/**/*.{ts,tsx,js,css,html,json}\" \"package.json\" \"tsconfig.base.json\" \"eslint.config.js\" \"docs/development/*.md\"",
    "typecheck": "pnpm --filter @dms/api typecheck && pnpm --filter @dms/web typecheck",
    "test": "pnpm -r --if-present test",
    "test:api": "pnpm --filter @dms/api test",
    "test:web": "pnpm --filter @dms/web test",
    "build": "node init && pnpm -r build",
    "db:migrate": "pnpm --filter @dms/api db:migrate",
    "db:rollback": "pnpm --filter @dms/api db:rollback",
    "owner:create": "pnpm --filter @dms/api owner:create",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
