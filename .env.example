# Copy to .env for local development only.
# Values below are local placeholders, not approved production settings.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://dms_local:replace-this-local-password@localhost:5432/dms
DATABASE_SSL=false
SESSION_SECRET=local-only-replace-with-a-random-secret-at-least-32-characters
# Development-only examples; production values require explicit approval.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY=false
APP_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:4000
